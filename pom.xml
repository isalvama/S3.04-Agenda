<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        groupId / artifactId / version definen el nombre del JAR generado:
        target/cli-agenda-1.0.jar  (artifactId-version.jar)
        ⚠️ El Dockerfile copia exactamente "cli-agenda-1.0.jar"; si cambias
           artifactId o version aquí, actualiza también el COPY del Dockerfile.
    -->
    <groupId>org.agenda</groupId>
    <artifactId>cli-agenda</artifactId>
    <version>1.0</version>

    <properties>
        <!-- Java 21 LTS: versión usada en las imágenes Docker del proyecto -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Clase principal de la aplicación CLI -->
        <main.class>org.agenda.App</main.class>
    </properties>

    <dependencies>
        <!--
            Driver JDBC de MySQL (Connector/J 8.x).
            Necesario para que DriverManager.getConnection() funcione.
            ⚠️ Error común: olvidar esta dependencia provoca ClassNotFoundException
               al intentar conectar a MySQL.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
        </dependency>

        <!-- JUnit 5 para tests unitarios -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                maven-shade-plugin: genera un "fat JAR" (uber JAR) que incluye
                todas las dependencias (driver MySQL, etc.) en un único archivo.
                Sin este plugin, el JAR generado no contiene el driver y falla
                con ClassNotFoundException al ejecutar en Docker.
                ⚠️ Error común: usar maven-jar-plugin sin shade produce un JAR
                   que no puede ejecutarse standalone.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Evita advertencias sobre archivos de módulo duplicados -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <!-- Define el Main-Class en el MANIFEST.MF del JAR -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Soporte para JUnit 5 en mvn test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

</project>